{
  "entities": {
    "Course": {
      "title": "Course",
      "description": "Master course curriculum catalog for English Chunks training",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "level_code": { "type": "string", "enum": ["LEVEL_A", "LEVEL_B"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "total_days": { "type": "number" },
        "total_chunks": { "type": "number" },
        "source": { "type": "string" },
        "is_active": { "type": "boolean" }
      },
      "required": ["id", "level_code", "title", "total_days", "total_chunks"]
    },
    "LessonDoc": {
      "title": "LessonDoc",
      "description": "15-day lesson containing chunk collections, prosody notations, and translations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "level_code": { "type": "string" },
        "day_number": { "type": "number" },
        "lesson_title": { "type": "string" },
        "lesson_type": { "type": "string" },
        "total_chunks": { "type": "number" },
        "categories": { "type": "array" },
        "chunks": { "type": "array" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "level_code", "day_number", "lesson_title", "chunks"]
    },
    "Cohort": {
      "title": "Cohort",
      "description": "15-session cohort class schedule and audio configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "level_code": { "type": "string" },
        "course_id": { "type": "string" },
        "teacher_id": { "type": "string" },
        "start_date": { "type": "string" },
        "total_sessions": { "type": "number" },
        "schedule_pattern": { "type": "object" },
        "sessions": { "type": "array" }
      },
      "required": ["id", "title", "level_code", "start_date", "total_sessions", "sessions"]
    }
  },
  "firestore": {
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Available courses catalog"
    },
    "/lessons/{lessonId}": {
      "schema": "LessonDoc",
      "description": "Curriculum lessons with all chunks and prosody metadata"
    },
    "/cohorts/{cohortId}": {
      "schema": "Cohort",
      "description": "Active class cohorts and 15-session schedules"
    }
  }
}
